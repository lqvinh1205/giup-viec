---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Steps from '../../components/Steps.astro';
import CTASection from '../../components/CTASection.astro';
import { breadcrumb } from '../../lib/schema';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ name: 'Dịch vụ', href: '/dich-vu/' }];
---
<BaseLayout
  title="Dịch vụ giúp việc gia đình, chăm bé, chăm người già"
  description="Các dịch vụ giúp việc của trung tâm: ở lại nhà, theo giờ, chăm bé, chăm người già, chăm người bệnh, tạp vụ văn phòng, giúp việc Tết. Giá công khai."
  jsonLd={[breadcrumb(crumbs)]}
>
  <PageHeader title="Dịch vụ giúp việc" lead="Mỗi dịch vụ có người được chọn riêng theo kinh nghiệm, kèm khung giá tham khảo và quy trình làm thử." crumbs={crumbs} />
  <section class="wrap py-14" aria-labelledby="ds">
    <h2 id="ds" class="sr-only">Danh sách dịch vụ</h2>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s, i) => <ServiceCard slug={s.id} index={i} {...s.data} />)}
    </div>
  </section>
  <section class="wrap py-10">
    <h2 class="mb-10 text-3xl">Quy trình chung</h2>
    <Steps />
  </section>
  <CTASection position="services-index" />
</BaseLayout>
