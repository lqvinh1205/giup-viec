---
import Icon from './Icon.astro';
import { site, telHref, zaloHref } from '../config/site';
interface Props { title?: string; text?: string; position?: string }
const {
  title = 'Cần người ngay tuần này?',
  text = `Gọi hoặc nhắn Zalo, tư vấn viên phản hồi trong ${site.responseTime} (${site.hours.label}).`,
  position = 'cta',
} = Astro.props;
---
<section class="wrap my-16">
  <div class="relative overflow-hidden bg-primary px-6 py-10 text-white sm:px-12 sm:py-14" style="border-radius: var(--radius-blob)">
    <h2 class="max-w-xl text-3xl !text-white sm:text-4xl">{title}</h2>
    <p class="mt-3 max-w-xl text-white/90">{text}</p>
    <div class="mt-7 flex flex-col gap-3 sm:flex-row">
      <a href={telHref} data-track="call" data-position={position} class="btn btn-accent"><Icon name="phone" size={20} /> Gọi {site.hotlineDisplay}</a>
      <a href={zaloHref} target="_blank" rel="noopener" data-track="zalo" data-position={position} class="btn border-2 border-white text-white hover:bg-white/10"><Icon name="zalo" size={22} /> Nhắn Zalo</a>
    </div>
  </div>
</section>
