---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { formatVnd } from '../lib/schema';
import { serviceImage } from '../lib/images';
interface Props { slug: string; name: string; summary: string; icon: string; priceFrom: number; priceUnit: string; index?: number }
const { slug, name, summary, icon, priceFrom, priceUnit } = Astro.props;
const photo = serviceImage(slug);
---
<a
  href={`/dich-vu/${slug}/`}
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-white no-underline shadow-[0_1px_2px_rgba(15,23,42,.04)] transition hover:-translate-y-1 hover:shadow-[0_16px_32px_-16px_rgba(30,58,138,.35)]"
>
  <div class="relative aspect-[16/10] overflow-hidden bg-paper-deep">
    {photo ? (
      <Image src={photo} alt="" widths={[320, 480, 640]} sizes="(min-width:1024px) 270px, (min-width:640px) 45vw, 92vw"
        class="size-full object-cover transition duration-500 group-hover:scale-105" />
    ) : (
      <span class="grid size-full place-items-center text-primary-soft"><Icon name={icon} size={48} /></span>
    )}
    <span class="absolute bottom-3 left-3 grid size-10 place-items-center rounded-xl bg-white text-primary shadow-md">
      <Icon name={icon} size={22} />
    </span>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg">{name}</h3>
    <p class="mt-2 flex-1 text-[0.95rem] leading-relaxed text-ink-soft">{summary}</p>
    <p class="mt-4 flex items-end justify-between border-t border-line pt-4">
      <span class="text-sm text-ink-soft">từ <strong class="font-display text-lg text-accent-deep">{formatVnd(priceFrom)}</strong>/{priceUnit}</span>
      <Icon name="arrow" size={22} class="text-primary-soft transition group-hover:translate-x-1" />
    </p>
  </div>
</a>
