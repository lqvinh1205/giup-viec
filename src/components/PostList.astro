---
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'blog'>[]; page: number; lastPage: number }
const { posts, page, lastPage } = Astro.props;
const href = (n: number) => (n === 1 ? '/cam-nang/' : `/cam-nang/page/${n}/`);
---
<ul class="grid gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
  {posts.map((p) => (
    <li class="flex flex-col border-t-2 border-primary pt-5">
      <p class="text-sm text-ink-soft">
        <time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toLocaleDateString('vi-VN')}</time>
        {p.data.tags[0] && <span> · {p.data.tags[0]}</span>}
      </p>
      <h2 class="mt-2 text-2xl"><a href={`/cam-nang/${p.id}/`} class="text-primary no-underline hover:text-primary-soft">{p.data.title}</a></h2>
      <p class="mt-3 text-ink-soft">{p.data.description}</p>
    </li>
  ))}
</ul>
{lastPage > 1 && (
  <nav aria-label="Phân trang" class="mt-14 flex items-center justify-center gap-2">
    {Array.from({ length: lastPage }, (_, i) => i + 1).map((n) => (
      <a href={href(n)} aria-current={n === page ? 'page' : undefined}
         class="grid size-11 place-items-center rounded-full border border-line font-semibold text-primary no-underline aria-[current=page]:bg-primary aria-[current=page]:text-paper">{n}</a>
    ))}
  </nav>
)}
