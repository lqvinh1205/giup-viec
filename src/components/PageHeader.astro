---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumb from './Breadcrumb.astro';
interface Props { title: string; lead?: string; crumbs: { name: string; href: string }[]; eyebrow?: string; image?: ImageMetadata }
const { title, lead, crumbs, eyebrow, image } = Astro.props;
---
<section class="border-b border-line bg-paper-deep">
  <div class:list={['wrap grid items-center gap-8 py-10 sm:py-14', image && 'lg:grid-cols-[1.25fr_1fr] lg:gap-14']}>
    <div>
      <Breadcrumb items={crumbs} />
      {eyebrow && <p class="eyebrow mt-6">{eyebrow}</p>}
      <h1 class:list={['max-w-3xl text-[2.1rem] sm:text-5xl', eyebrow ? 'mt-3' : 'mt-6']}>{title}</h1>
      {lead && <p class="mt-4 max-w-2xl text-lg text-ink-soft">{lead}</p>}
      <slot />
    </div>
    {image && (
      <Image src={image} alt="" widths={[480, 720, 960]} sizes="(min-width:1024px) 440px, 92vw" loading="eager"
        class="hidden aspect-[4/3] w-full rounded-3xl object-cover shadow-lg lg:block" />
    )}
  </div>
</section>
